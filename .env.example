NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://cornven:cornven_local@localhost:5432/cornven?schema=public
LOG_LEVEL=info

# Local persistent directory for generated report PDFs. Must be a real
# directory (not a symlink) with read/write access for the API process.
# See docs/development/report-storage.md for details.
REPORT_STORAGE_PATH=./data/reports

# Real credentials must stay in a local .env file or an approved secret manager.
# Never commit POS, GitHub, database, or LLM passwords/tokens.
POS_MODE=mock
POS_API_BASE_URL=
POS_API_TOKEN=
LLM_PROVIDER=disabled
LLM_API_KEY=

# M6 RAG defaults work offline. Set provider=openai only when an approved API key is available.
RAG_STORAGE_BACKEND=memory
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_API_KEY=
# Optional approved HTTP(S) endpoint override. Leave blank for the provider default.
RAG_EMBEDDING_ENDPOINT=
# Use 0.2 for the deterministic local provider. The reviewed OpenAI evaluation uses 0.5.
RAG_SEARCH_MIN_SCORE=0.2

# Chatbot intent classification and grounded SOP answers (server only).
# Set a real key locally; never use VITE_ for credentials or commit the .env file.
OPENAI_API_KEY=
# Model is fixed to gpt-5.4-nano. RAG embedding configuration is independent.
