[
  {
    "name": "sales.search",
    "description": "Search permission-filtered canonical sales records.",
    "readOnly": true,
    "owner": "A2",
    "input": {
      "type": "object",
      "required": ["artistId"],
      "properties": {
        "artistId": {
          "type": "string"
        },
        "rentalId": {
          "type": "string"
        },
        "periodStart": {
          "type": "string",
          "format": "date"
        },
        "periodEnd": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "recordCount",
        "grossSalesCents",
        "refundAmountCents",
        "netSalesCents",
        "sourceCommissionAmountCents",
        "sourceTenantAmountCents",
        "currency",
        "records"
      ],
      "properties": {
        "recordCount": {
          "type": "integer"
        },
        "grossSalesCents": {
          "type": "integer"
        },
        "refundAmountCents": {
          "type": "integer"
        },
        "netSalesCents": {
          "type": "integer"
        },
        "sourceCommissionAmountCents": {
          "type": "integer"
        },
        "sourceTenantAmountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "recordType",
              "rentalId",
              "soldAt",
              "grossSalesCents",
              "sourceCommissionAmountCents",
              "sourceTenantAmountCents",
              "currency"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "recordType": {
                "type": "string",
                "enum": ["SALE", "REFUND"]
              },
              "rentalId": {
                "type": "string"
              },
              "soldAt": {
                "type": "string",
                "format": "date-time"
              },
              "grossSalesCents": {
                "type": "integer"
              },
              "sourceCommissionAmountCents": {
                "type": "integer"
              },
              "sourceTenantAmountCents": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
