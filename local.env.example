# Dedicated mock environment; these are local-only fixture credentials.
DATABASE_URL=postgresql://cornven_planb:mock_only_local@127.0.0.1:55449/cornven_planb?schema=public
API_PORT=3119
WEB_PORT=5190
LOCAL_DEVELOPMENT_IDENTITY=true
REPORT_STORAGE_PATH=.local/reports
REPORT_SCHEDULER_START_MONTH=2026-08
# Optional: use a locally installed browser; omit to use Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Chatbot intent classification and grounded SOP answers (server only).
# Set a real key locally; never use VITE_ for credentials or commit the .env file.
OPENAI_API_KEY=
# Model is fixed to gpt-5.4-nano. RAG embedding configuration is independent.

# Report email: local captures mail only in the local Mailpit inbox (no external relay).
# Set DELIVERY_MODE=smtp and fill SMTP_* to send to real mailboxes.
DELIVERY_MODE=local
DELIVERY_FROM=reports@cornven.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# RAG is switched to openai only after source/retrieval/answer acceptance.
RAG_STORAGE_BACKEND=memory
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
# Optional nonblank RAG_EMBEDDING_API_KEY takes priority over OPENAI_API_KEY.
# Leave RAG_SEARCH_MIN_SCORE unset to use independently calibrated language thresholds.

# SOP context ceiling selected by the user for Plan B; do not force-fill irrelevant passages.
RAG_TOP_K=8
# Conservative UTF-8 byte upper bound for serialized references, not exact billed tokens.
RAG_CONTEXT_TOKEN_BUDGET=16000
